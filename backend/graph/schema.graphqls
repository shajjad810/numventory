type Category {
  id: ID!
  name: String!
}

type Product {
  id: ID!
  sku: String!
  name: String!
  description: String
  categoryId: ID
  unit: String!
}

type Location {
  id: ID!
  name: String!
  description: String
}

type Query {
  categories: [Category!]!
  products: [Product!]!
  locations: [Location!]!

  inventory: [Inventory!]!
  inventoryTransactions: [InventoryTransaction!]!
}

input CreateCategoryInput {
  name: String!
}

input CreateProductInput {
  sku: String!
  name: String!
  description: String
  categoryId: ID
  unit: String!
}

input CreateLocationInput {
  name: String!
  description: String
}

type Mutation {
  createCategory(input: CreateCategoryInput!): Category!
  createProduct(input: CreateProductInput!): Product!
  createLocation(input: CreateLocationInput!): Location!

  receiveInventory(input: ReceiveInventoryInput!): InventoryTransaction!
}

type Inventory {
  id: ID!
  productId: ID!
  locationId: ID!
  quantity: Float!
}

type InventoryTransaction {
  id: ID!
  productId: ID!
  locationId: ID!
  transactionType: String!
  quantity: Float!
  reference: String
  notes: String
  createdAt: String!
}

input ReceiveInventoryInput {
  productId: ID!
  locationId: ID!
  quantity: Float!
  reference: String
  notes: String
}
