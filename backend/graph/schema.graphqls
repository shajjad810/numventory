type Category {
  id: ID!
  name: String!
}

type Product {
  id: ID!
  sku: String!
  name: String!
  description: String
  categoryId: ID
  unit: String!
}

type Location {
  id: ID!
  name: String!
  description: String
}

type User {
  id: ID!
  name: String!
  email: String!
  createdAt: String!
}

input RegisterUserInput {
  name: String!
  email: String!
  password: String!
}

input LoginInput {
  email: String!
  password: String!
}

type AuthPayload {
  token: String!
  user: User!
}

type Query {
  categories: [Category!]!
  products: [Product!]!
  locations: [Location!]!

  inventory: [Inventory!]!
  inventoryTransactions: [InventoryTransaction!]!
}

input CreateCategoryInput {
  name: String!
}

input CreateProductInput {
  sku: String!
  name: String!
  description: String
  categoryId: ID
  unit: String!
}

input CreateLocationInput {
  name: String!
  description: String
}

type Mutation {
  createCategory(input: CreateCategoryInput!): Category!
  createProduct(input: CreateProductInput!): Product!
  createLocation(input: CreateLocationInput!): Location!
  receiveInventory(input: ReceiveInventoryInput!): InventoryTransaction!
  shipInventory(input: ShipInventoryInput!): InventoryTransaction!
  recordWaste(input: RecordWasteInput!): InventoryTransaction!
  processProduction(input: ProcessProductionInput!): [InventoryTransaction!]!
  transferInventory(input: TransferInventoryInput!): InventoryTransaction!
  registerUser(input: RegisterUserInput!): User!
  login(input: LoginInput!): AuthPayload!
}

type Inventory {
  id: ID!
  productId: ID!
  locationId: ID!
  quantity: Float!
}

type InventoryTransaction {
  id: ID!
  productId: ID!
  locationId: ID!
  transactionType: String!
  quantity: Float!
  reference: String
  notes: String
  createdAt: String!
  fromLocationId: ID
  toLocationId: ID
}

input ReceiveInventoryInput {
  productId: ID!
  locationId: ID!
  quantity: Float!
  reference: String
  notes: String
}

input ShipInventoryInput {
  productId: ID!
  locationId: ID!
  quantity: Float!
  reference: String
  notes: String
}

input RecordWasteInput {
  productId: ID!
  locationId: ID!
  quantity: Float!
  reason: String!
  reference: String
  notes: String
}

input ProcessProductionInput {
  rawProductId: ID!
  finishedProductId: ID!
  locationId: ID!
  rawQuantity: Float!
  finishedQuantity: Float!
  reference: String
  notes: String
}

input TransferInventoryInput {
  productId: ID!
  fromLocationId: ID!
  toLocationId: ID!
  quantity: Float!
  reference: String
  notes: String
}
